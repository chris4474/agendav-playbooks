services:
  db-init:
    image: mariadb:10
{% if generate_full_stack | default(false) %}
    depends_on:
      mariadb:
        condition: service_healthy
{% endif %}
    volumes:
      - ./init_db.sh:/init_db.sh
      - ./init_db.d/:/init_db.d/
    networks:
      - mariadb_network
    entrypoint: /init_db.sh
    healthcheck:
      test: ["CMD", "test", "-f", "/tmp/db_initialized"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 5s
networks:
  mariadb_network:
