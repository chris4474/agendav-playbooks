services:
  agendav:
    image: gitea.symphorines.home/chris/agendav:latest
    pull_policy: always
    container_name: agendav
    networks:
    - mariadb_network
    restart: unless-stopped
    ports:
    - {{ agendav_published_port }}:8080
    environment:
      AGENDAV_SERVER_NAME: {{ agendav_server_name | default ('agendav') }}
      AGENDAV_TITLE: Serveur Agendas
      AGENDAV_FOOTER: {{ agendav_footer | default('Agendav footer') }}
      AGENDAV_CALDAV_SERVER: {{ agendav_caldav_server | default ('baikal') }}
      AGENDAV_CALDAV_PUBLIC_URL: {{ agendav_caldav_public_url | default('127.0.0.1:8081') }}
      AGENDAV_TIMEZONE: {{ agendav_timezone | default('Europe/Paris') }}
      AGENDAV_LANG: {{ agendav_lang | default ('en') }}
      AGENDAV_WEEKSTART: {{ agendav_weekstart | default('1') }}
      AGENDAV_LOG_DIR: tmp/
      AGENDAV_ENVIRONMENT: {{ agendav_environment | default ('dev') }}
      AGENDAV_DB_HOST: ${AGENDAV_DB_HOST:-mariadb}
      AGENDAV_DB_DATABASE: ${AGENDAV_DB_DATABASE:-agendav}
      AGENDAV_DB_USER: ${AGENDAV_DB_USER:-agendav}
      AGENDAV_DB_PASSWORD: ${AGENDAV_DB_PASSWORD:-baikal_password}
networks:
  mariadb_network:
    external: true
