services:
  mariadb:
    image: mariadb:10
    restart: unless-stopped
    ports:
      - 127.0.0.1:3306:3306
    env_file:
      - .env
    networks:
      - mariadb_network
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 10s
    volumes:
      - mariadb_data:/var/lib/mysql

volumes:
  mariadb_data:

networks:
  mariadb_network:
