services:
  baikal:
    image: ghcr.io/aalmenar/baikal:latest
{% if generate_full_stack | default(false) %}
    depends_on:
      mariadb:
        condition: service_healthy
      db-init:
        condition: service_completed_successfully
{% endif %}
    networks:
      - mariadb_network
    restart: unless-stopped
    ports:
      - {{ baikal_published_port }}:80
    volumes:
      - baikal_config:/var/www/baikal/config
      - baikal_data:/var/www/baikal/Specific
      - ./baikal_config.yaml:/var/www/baikal/config/baikal.yaml
volumes:
  baikal_config:
  baikal_data:
 
networks:
  mariadb_network:
    external: true
