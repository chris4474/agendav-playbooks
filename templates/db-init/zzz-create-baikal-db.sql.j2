CREATE DATABASE IF NOT EXISTS `{{ baikal_db_database }}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '{{ baikal_db_user }}'@'%' IDENTIFIED BY '{{ baikal_db_password }}';
GRANT ALL PRIVILEGES ON `{{ baikal_db_database }}`.* TO '{{ baikal_db_user }}'@'%';
FLUSH PRIVILEGES;
