services:
  mariadb:
    image: mariadb:10
    container_name: mariadb
    restart: unless-stopped
    ports:
      - 127.0.0.1:3306:3306
    environment:
      MARIADB_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD}
    networks:
      - mariadb_network
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 10s
    volumes:
      - mariadb_data:/var/lib/mysql

networks:
  mariadb_network:
    external: true

volumes:
  mariadb_data:
