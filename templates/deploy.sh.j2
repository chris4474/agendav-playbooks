#!/bin/bash
playbook_dir={{ playbook_dir }}
thisdir=$PWD

#
# deploy mariadb
#
cd {{ compose_folder }}/mariadb
docker compose up -d
sleep 10

#
# Create the required databses
#
cd ${playbook_dir}
ansible-playbook create_DBs.yaml

#
# deploy baikal
#
cd {{ compose_folder }}/baikal
docker compose up -d
sleep 5

#
# deploy agendav
#
cd {{ compose_folder }}/agendav
docker compose up -d

echo Create a user in baikal and then logon in agendav

cd ${thisdir}


