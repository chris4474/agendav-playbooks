services:
  agendav:
    image: {{ agendav_image }}
    pull_policy: always
{% if generate_full_stack | default(true) %}
    depends_on:
      mariadb:
        condition: service_healthy
      db-init:
        condition: service_healthy
{% endif %}
    networks:
    - mariadb_network
    restart: unless-stopped
    ports:
    - {{ agendav_published_port }}:8080
    env_file:
      - .env
networks:
  mariadb_network:
